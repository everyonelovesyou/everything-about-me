---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog" description="ブログ記事一覧" pageClass="page-blog">
  <main class="blog-page">
    <section class="blog-hero">
      <h1>Blog</h1>
      <p class="subtitle">Thoughts & Notes</p>
    </section>

    <section class="post-list">
      {posts.length === 0 && <p class="empty">まだ記事がありません。</p>}
      {
        posts.map((post) => (
          <a href={`${base}/blog/${post.id}/`} class="post-card">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags && (
              <div class="tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .blog-page {
    min-height: 100svh;
    background: linear-gradient(160deg, #eff6ff 0%, #ffffff 50%, #f0f4ff 100%);
    color: #4a5568;
  }

  .blog-hero {
    padding: 6rem 2rem 3rem;
    text-align: center;
  }

  .blog-hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    color: #6b8abf;
  }

  .subtitle {
    font-size: 1rem;
    color: #94a8c8;
    margin-top: 0.5rem;
  }

  .post-list {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty {
    text-align: center;
    color: #94a8c8;
  }

  .post-card {
    display: block;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    border-radius: 1rem;
    border: 1.5px solid rgba(107, 138, 191, 0.12);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(107, 138, 191, 0.15);
  }

  .post-card time {
    font-size: 0.8rem;
    color: #94a8c8;
  }

  .post-card h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #4a5a7a;
    margin-top: 0.3rem;
  }

  .post-card p {
    font-size: 0.88rem;
    color: #6b7a9a;
    margin-top: 0.4rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: #eff6ff;
    border-radius: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #6b8abf;
  }
</style>
