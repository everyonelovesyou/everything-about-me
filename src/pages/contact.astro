---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="お問い合わせ" pageClass="page-contact">
  <main class="contact-page">
    <section class="contact-hero">
      <h1>Contact</h1>
      <p class="subtitle">Get in touch</p>
    </section>

    <section class="contact-content">
      <div class="contact-card">
        <p class="message">お気軽にご連絡ください。</p>
        <ul class="contact-links">
          <li>
            <a
              href="https://github.com/"
              class="contact-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-icon">◈</span>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a
              href="https://twitter.com/"
              class="contact-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-icon">◇</span>
              <span>X (Twitter)</span>
            </a>
          </li>
          <li>
            <a href="mailto:example@example.com" class="contact-link">
              <span class="link-icon">♢</span>
              <span>Email</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    min-height: 100svh;
    background: linear-gradient(160deg, #fff5f0 0%, #fff0f6 50%, #fef3e2 100%);
    color: #6b4a55;
  }

  .contact-hero {
    padding: 6rem 2rem 3rem;
    text-align: center;
  }

  .contact-hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, #f9a8c9, #e8a87c, #d4a574);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    font-size: 1rem;
    color: #c9937e;
    margin-top: 0.5rem;
  }

  .contact-content {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    border: 1.5px solid rgba(233, 168, 135, 0.2);
    text-align: center;
  }

  .message {
    font-size: 1rem;
    color: #8b6b70;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #fff5f0, #fff0f6);
    border: 1.5px solid rgba(233, 168, 135, 0.15);
    font-weight: 600;
    font-size: 0.95rem;
    color: #7b5a60;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(233, 168, 135, 0.2);
  }

  .link-icon {
    font-size: 1.1rem;
    color: #e8a87c;
  }
</style>
