---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Project 1',
    description: 'プロジェクトの説明をここに書きます。',
    tags: ['TypeScript', 'React'],
    url: '#',
  },
  {
    title: 'Project 2',
    description: 'プロジェクトの説明をここに書きます。',
    tags: ['Astro', 'CSS'],
    url: '#',
  },
  {
    title: 'Project 3',
    description: 'プロジェクトの説明をここに書きます。',
    tags: ['Node.js', 'Express'],
    url: '#',
  },
];
---

<BaseLayout title="Works" description="ポートフォリオ" pageClass="page-works">
  <main class="works-page">
    <section class="works-hero">
      <h1>Works</h1>
      <p class="subtitle">Things I've built</p>
    </section>

    <section class="works-grid">
      {
        projects.map((project) => (
          <a href={project.url} class="project-card">
            <div class="card-accent" />
            <div class="card-body">
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .works-page {
    min-height: 100svh;
    background: linear-gradient(135deg, #fef9e7 0%, #fff5eb 40%, #f5edff 100%);
    color: #5a4a6b;
  }

  .works-hero {
    padding: 6rem 2rem 3rem;
    text-align: center;
  }

  .works-hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, #f59e0b, #e879a8, #a78bfa);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    font-size: 1rem;
    color: #c49b5a;
    margin-top: 0.5rem;
  }

  .works-grid {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: block;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    border-radius: 1.2rem;
    overflow: hidden;
    border: 1.5px solid rgba(245, 158, 11, 0.15);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(245, 158, 11, 0.15);
  }

  .card-accent {
    height: 6px;
    background: linear-gradient(90deg, #fbbf24, #f472b6, #a78bfa);
  }

  .card-body {
    padding: 1.5rem;
  }

  .card-body h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #5a4a6b;
    margin-bottom: 0.5rem;
  }

  .card-body p {
    font-size: 0.9rem;
    color: #7a6a8b;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.25rem 0.7rem;
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #92700c;
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
