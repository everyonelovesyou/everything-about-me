---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" pageClass="page-top">
  <main class="main">
    <div class="hero">
      <h1 class="site-title" lang="en" translate="no">Everything about me</h1>
      <div class="hearts" aria-hidden="true">
        <img src={`${import.meta.env.BASE_URL}/images/icon-heart.svg`} width="" height="" />
      </div>
    </div>

    <div class="links">
      <a href={`${import.meta.env.BASE_URL}/about/`} class="link-card">
        <span class="card-icon">♥</span>
        <span>About</span>
      </a>
      <a href={`${import.meta.env.BASE_URL}/works/`} class="link-card">
        <span class="card-icon">⚙</span>
        <span>Works</span>
      </a>
      {/* <a href={`${import.meta.env.BASE_URL}/blog/`} class="link-card">
        <span class="card-icon">✎</span>
        <span>Blog</span>
      </a> */}
      <a href={`${import.meta.env.BASE_URL}/contact/`} class="link-card">
        <span class="card-icon">✉</span>
        <span>Contact</span>
      </a>
    </div>
  </main>
</BaseLayout>

<style lang="scss" is:global>
  .page-top {
    background-image: linear-gradient(135deg, #fff0f6, #f3e8ff 40%, #fef3c7);
    background-size: cover;
  }

  .center {
    background-image: url('/images/index/bg-center.jpg');
    background-size: 100%;
    background-position: top center;
    background-repeat: repeat-y;
  }
</style>

<style lang="scss">
  @use '/src/styles/mixin/_shadow' as *;
  .main {
    min-height: 100%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 3rem;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    // background: pink;

    .site-title {
      font-size: clamp(2.4rem, 12vw, 6rem);
      color: #fff;
      font-weight: 800;
      letter-spacing: 0.025em;
      line-height: 1.12;
      -webkit-text-stroke: 0.05em #b19797;
      text-stroke: 0.05em #b19797;
      paint-order: stroke;
      // text-shadow: 0 0 0.1em #c99;
      // @include textShadow(#c99, 1px);
      @include dropShadow(3, #fff, 0.05em);
      text-wrap-style: balance;

      @media (width > 768px) {
        font-size: 5rem;
      }
    }
  }

  .hearts {
    margin-top: 1.2rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-size: 1.2rem;
    color: #f9a8d4;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 400px;
    width: 100%;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.5rem 1rem;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(244, 194, 215, 0.4);
    font-size: 0.9rem;
    font-weight: 600;
    color: #7c6a82;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .link-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(244, 194, 215, 0.35);
  }

  .card-icon {
    font-size: 1.5rem;
  }

  @media (max-width: 480px) {
    .links {
      gap: 0.8rem;
    }
    .link-card {
      padding: 1.2rem 0.8rem;
    }
  }

  .patchwork-bg {
    position: absolute;
    inset: 0;
  }
</style>
