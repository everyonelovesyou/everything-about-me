---
import FloatingNav from '../components/FloatingNav.astro';
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const { title, description = 'ポートフォリオサイト', pageClass = '' } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <div class="layout">
      <!-- <aside class="side side--left"></aside> -->
      <div class="center">
        <slot />
      </div>
      <!-- <aside class="side side--right"></aside> -->
      <FloatingNav />
    </div>
  </body>
</html>

<style is:global lang="scss">
  :root {
    --center-width: 480px;
  }

  .layout {
    display: grid;
    grid-template-areas: 'center';
    min-height: 100svh;

    .center {
      grid-area: center;
    }

    .floating-nav {
      place-self: end;
      position: sticky;
      margin-bottom: calc(env(safe-area-inset-bottom) + var(--_offset));
      margin-right: var(--_offset);
      z-index: 100;
      grid-area: center;
    }

    .side--left {
      grid-area: left;
    }

    .side--right {
      grid-area: right;
    }

    @media not (width > 768px) {
      .side {
        display: none;
      }
    }

    @media (width > 768px) {
      grid-template:
        [fill-start] 'left center right' [fill-end]
        / [fill-start] 1fr var(--center-width) 1fr [fill-end];

      .floating-nav {
        grid-area: fill;
      }
    }
  }
</style>
