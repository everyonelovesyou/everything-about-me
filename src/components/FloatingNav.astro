---
const base = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Top', href: `${base}/` },
  { label: 'About', href: `${base}/about/` },
  { label: 'Works', href: `${base}/works/` },
  { label: 'Blog', href: `${base}/blog/` },
  { label: 'Contact', href: `${base}/contact/` },
];
---

<nav class="floating-nav">
  <button id="nav-btn" class="nav-btn" popovertarget="nav-menu">✦</button>
  <div id="nav-menu" class="nav-menu" popover>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style is:global lang="scss">
  .floating-nav {
    --_offset: 2rem;
    --_btn-size: 3.2rem;
    --_border-col: #ffb7da;
  }
</style>

<style lang="scss">
  @use '/src/styles/mixin/_hover' as *;

  .nav-btn {
    font-size: 1.3rem;
    width: var(--_btn-size);
    height: var(--_btn-size);
    border-radius: 50%;
    display: grid;
    place-items: center;

    &:not(:disabled) {
      color: oklch(from var(--_border-col) calc(l - 0.36) calc(c - 0.02) h);
      border: 2px solid var(--_border-col);
      background-color: rgb(from #fff r g b / 0.9);
      box-shadow: 0 4px 16px rgb(from var(--_border-col) r g b / 0.35);

      transition-duration: 0.2s;
      transition-timing-function: ease;
      transition-property: color, translate, box-shadow;

      @include hover('&:has(+ :popover-open)') {
        color: oklch(from var(--_border-col) calc(l - 0.2) calc(c + 0.08) h);
        translate: 0 -3px;
        box-shadow: 0 6px 20px rgb(from var(--_border-col) r g b / 0.5);
      }
    }
  }

  .nav-menu {
    color: oklch(from var(--_border-col) calc(l - 0.36) calc(c - 0.02) h);
    background-color: rgb(from #fff r g b / 0.9);
    border-radius: 1rem;
    border: 1px solid var(--_border-col);
    box-shadow: 0 8px 32px rgb(from var(--_border-col) r g b / 0.25);
    padding: 0.5rem;
    min-width: 9rem;
    bottom: calc(anchor(top) + 1rem);
    right: anchor(right);

    @supports not (right: anchor(right)) {
      bottom: calc(var(--_offset) + var(--_btn-size) + 1rem);
      right: calc(var(--_offset) + var(--_btn-size));
    }
  }

  .nav-menu a {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;

    &:any-link {
      transition: background-color 0.15s ease;

      @include hover() {
        background-color: oklch(from var(--_border-col) calc(l + 0.1) calc(c - 0.04) h);
        color: oklch(from var(--_border-col) calc(l - 0.2) calc(c + 0.08) h);
      }
    }
  }
</style>
