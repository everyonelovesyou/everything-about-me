---
const patches = [
  { classNames: ['bg-pink', 'pattern-gingham'] },
  { classNames: ['bg-green', 'pattern-flowers-1'] },
  { classNames: ['bg-blue', 'pattern-dots'] },
  //
  { classNames: ['bg-blue', 'pattern-stars-2'] },
  { classNames: ['bg-pink', 'pattern-dots'] },
  { classNames: ['bg-yellow', 'pattern-stars-1'] },
  //
  { classNames: ['bg-yellow', 'pattern-gingham'] },
  { classNames: ['bg-blue', 'pattern-dots'] },
  { classNames: ['bg-pink', 'pattern-flowers-2'] },
  //
  { classNames: ['bg-green', 'pattern-dots'] },
  { classNames: ['bg-yellow', 'pattern-flowers-3'] },
  { classNames: ['bg-blue', 'pattern-gingham'] },
  //
  { classNames: ['bg-pink', 'patter-flowers-2'] },
  { classNames: ['bg-blue', 'pattern-dots'] },
  { classNames: ['bg-yellow', 'pattern-stars-2'] },
];
---

<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g class="group">
    {patches.map((patch, i) => <rect class:list={patch.classNames} />)}
  </g>
</svg>

<style lang="scss">
  svg {
    position: absolute;
    top: 0;
    container-type: inline-size;
    aspect-ratio: 3 / 5;
    width: 100%;

    @media (width > 768px) {
      width: var(--center-width);
    }
  }

  .group {
    width: 100%;
    height: 100%;
  }

  rect {
    width: calc(100cqw / 3);
    height: calc(100cqw / 3);

    &:nth-child(3n + 1) {
      x: 0;
    }

    &:nth-child(3n + 2) {
      x: calc(100cqw / 3);
    }

    &:nth-child(3n) {
      x: calc(100cqw * 2 / 3);
    }

    @for $i from 1 through 5 {
      &:nth-child(n + #{3 * ($i - 1) + 1}):nth-child(-n + #{3 * $i}) {
        y: calc(100cqw * #{calc(($i - 1))} / 3);
      }
    }
  }
</style>
